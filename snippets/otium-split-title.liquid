{%- comment -%}
  Otium — split a product title into Name / Duft / Produkt.
  Supported title formats (separators may be -, –, — around spaces):
    "Name — Produkt, Duft"      (dash for the name, comma for produkt/duft)
    "Name — Produkt — Duft"     (dash for all three)
  Display order: Name, Duft, Produkt. Falls back to the plain title otherwise.

  Params:
    title  {String}  the raw product title (required)
    labels {Boolean} true  -> product page: big name + Altrosa role labels
                     false -> catalog card: compact name + quiet lines
{%- endcomment -%}
{%- liquid
  assign dash = '|||'
  assign norm = title | replace: ' — ', dash | replace: ' – ', dash | replace: ' - ', dash
  assign dparts = norm | split: dash
  assign found = false

  if dparts.size == 3
    assign otm_name = dparts[0] | strip
    assign otm_produkt = dparts[1] | strip
    assign otm_duft = dparts[2] | strip
    assign found = true
  elsif dparts.size == 2
    assign otm_name = dparts[0] | strip
    assign rest = dparts[1] | strip
    assign cparts = rest | split: ', '
    if cparts.size >= 2
      assign otm_produkt = cparts[0] | strip
      assign otm_duft = rest | remove_first: cparts[0] | replace_first: ',', '' | strip
    else
      assign otm_produkt = rest
      assign otm_duft = ''
    endif
    assign found = true
  endif
-%}
{%- if found -%}
  {%- if labels -%}
    <span class="otium-eyebrow" aria-hidden="true">Name</span>
    <span class="product__title-name">{{ otm_name | escape }}</span>
    {%- if otm_duft != blank -%}
      <span class="otium-eyebrow" aria-hidden="true">Duft</span>
      <span class="product__title-line">{{ otm_duft | escape }}</span>
    {%- endif -%}
    {%- if otm_produkt != blank -%}
      <span class="otium-eyebrow" aria-hidden="true">Produkt</span>
      <span class="product__title-line">{{ otm_produkt | escape }}</span>
    {%- endif -%}
  {%- else -%}
    <span class="otium-cardtitle__name">{{ otm_name | escape }}</span>
    {%- if otm_duft != blank -%}
      <span class="otium-cardtitle__line">{{ otm_duft | escape }}</span>
    {%- endif -%}
    {%- if otm_produkt != blank -%}
      <span class="otium-cardtitle__line">{{ otm_produkt | escape }}</span>
    {%- endif -%}
  {%- endif -%}
{%- else -%}
  {{ title | escape }}
{%- endif -%}
